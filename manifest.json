{
  "manifest_version": 3,
  "name": "CJTS Legal Co-Pilot",
  "version": "1.0",
  "description": "AI-assisted guidance for Self-Represented Persons navigating the Singapore Small Claims Tribunals.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://opulent-capybara-97r5w4r6wx9rfxx69-8000.app.github.dev/*"
  ],
  "action": {
    "default_title": "Open CJTS Co-Pilot"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}