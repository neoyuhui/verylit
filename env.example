# Copy this file to backend/.env and fill in real values yourself, directly
# in the file. Do not paste real key values into a Cline/Claude/other AI
# chat prompt — that sends the secret into that conversation's history.
#
#   cp .env.example .env
#
# backend/.env is covered by .gitignore — verify that before committing.

# "anthropic" (default, calls api.anthropic.com directly) or "openrouter"
LLM_PROVIDER=openrouter

# Needed only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Needed only if LLM_PROVIDER=openrouter — get this from https://openrouter.ai/keys
OPENROUTER_API_KEY=
